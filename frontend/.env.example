NEXT_PUBLIC_API_URL=http://localhost:4000

# Shared with the frontend's PROXY_SHARED_SECRET (same value on both). Lets the
# frontend proxy tell the API each visitor's real IP, so rate limits (login,
# bookings, testimonials) apply per visitor instead of to the whole site.
# Without it every visitor shares one bucket. `openssl rand -base64 48`
PROXY_SHARED_SECRET=

# REQUIRED IN PRODUCTION. Shared secret for POST /api/revalidate, which busts the
# public content cache on demand (e.g. after an admin edit). Without it the route
# returns 503 in production rather than falling open — an unauthenticated
# cache-purge endpoint can be looped to force cold backend fetches. Leave unset in
# dev: the route then allows unauthenticated calls and logs a warning, which is
# what the E2E suite relies on to make cache-dependent journeys deterministic.
REVALIDATE_SECRET=
