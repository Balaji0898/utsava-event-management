# ---------------------------------------------------------------------------
# Utsava E2E suite — copy to `e2e/.env` and fill in. `.env` is gitignored.
# ---------------------------------------------------------------------------

# --- Where the suite points -------------------------------------------------
# Defaults are the addresses `scripts/stack.mjs` boots the ephemeral stack on.
# 127.0.0.1 (not localhost) avoids Node's IPv6-first resolution stalling against
# Nest's IPv4 listener.
E2E_BASE_URL=http://127.0.0.1:3000
E2E_API_URL=http://127.0.0.1:4000

# --- Seeded admin credentials ----------------------------------------------
# Injected into `prisma migrate reset` as SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD.
# MUST be >= 8 chars: backend/prisma/seed.ts falls back to a random generated
# password below that length and only prints it once, which we cannot read back.
E2E_ADMIN_EMAIL=e2e-admin@utsava.test
E2E_ADMIN_PASSWORD=E2eAdmin!2026

# --- Database mode ----------------------------------------------------------
# `neon`     : branch-per-run (default when NEON_* are present). Recommended.
# `external` : bring your own Postgres via E2E_DATABASE_URL.
# E2E_DB_MODE=neon

# Neon branch-per-run. Get these from https://console.neon.tech
#   NEON_API_KEY    -> Account settings -> API keys
#   NEON_PROJECT_ID -> your project -> Settings -> General
NEON_API_KEY=
NEON_PROJECT_ID=
# Optional: fork from a specific branch instead of the project's primary.
# NEON_PARENT_BRANCH_ID=
# NEON_DATABASE_NAME=neondb
# NEON_ROLE_NAME=neondb_owner
# Reap orphaned e2e/* branches older than this many hours (default 6).
# E2E_BRANCH_TTL_HOURS=6

# Escape hatch: any Postgres you are willing to have DROPPED AND RESEEDED.
# The guard in scripts/lib/guard.mjs refuses unless the host is localhost, the
# host/db name contains an `e2e`/`test`/`ci` marker, or you set
# E2E_ALLOW_DESTRUCTIVE_DB=1. It hard-refuses the known production endpoint
# outright, with no override.
# E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/utsava_e2e

# --- Run-mode switches ------------------------------------------------------
# Skip DB provisioning + stack boot; run against an already-running stack.
# Every @mutates spec test.skip()s in this mode.
# E2E_SKIP_DB=1
# Reuse an existing `next build` / `nest build` (fast local loop).
# E2E_SKIP_BUILD=1
# Leave the Neon branch alive after the run for post-mortem psql. GC reaps in 6h.
# E2E_KEEP_BRANCH=1
# Let Playwright's `webServer` boot a dev stack instead of scripts/stack.mjs.
# Only valid against an already-prepared database.
# E2E_WEBSERVER=1
# Give every worker its own throttler bucket via X-Forwarded-For (default 1).
# The rate-limit security specs set this to 0 so they can observe a real 429.
# E2E_IP_PARTITION=1
# I know what I am doing; reset the database I named above.
# E2E_ALLOW_DESTRUCTIVE_DB=1
