# ---- Shared / Docker ----
POSTGRES_USER=elite
POSTGRES_PASSWORD=elite_secret
POSTGRES_DB=elite_events

# ---- Backend ----
DATABASE_URL=postgresql://elite:elite_secret@localhost:5432/elite_events?schema=public
# Generate strong random values (app refuses blank/placeholder): openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
PORT=4000
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# ---- File uploads (optional; blank = local disk storage) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# REQUIRED IN PRODUCTION. Shared secret for POST /api/revalidate, which busts the public content
# cache on demand after an admin edit. Without it the route returns 503 in production rather than
# falling open — an unauthenticated cache-purge endpoint can be looped to force cold backend
# fetches. Leave blank in development: the route then allows unauthenticated calls (and logs a
# warning), which is what the E2E suite relies on.
REVALIDATE_SECRET=
