# ---- Shared / Docker ----
POSTGRES_USER=elite
POSTGRES_PASSWORD=elite_secret
POSTGRES_DB=elite_events

# ---- Backend ----
DATABASE_URL=postgresql://elite:elite_secret@localhost:5432/elite_events?schema=public
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
PORT=4000
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# ---- File uploads (optional; blank = local disk storage) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000
