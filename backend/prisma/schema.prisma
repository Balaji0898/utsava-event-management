// Elite Event Management Platform — dynamic, scalable data model.
// Departments → Categories → Items, plus Vendors, multi-tier Packages,
// dynamic pricing, bookings, reviews, and role-based users.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------ enums

enum Role {
  SUPER_ADMIN
  ADMIN
  VENDOR
  CUSTOMER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum PriceUnit {
  PER_PLATE
  PER_PERSON
  PER_KG
  PER_ITEM
  PER_HOUR
  PER_DAY
  FIXED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum CmsBlockType {
  BANNER
  SLIDER
  SECTION
  FOOTER
  ABOUT
}

enum MediaProvider {
  LOCAL
  CLOUDINARY
}

// ------------------------------------------------------------------ auth

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role      @default(CUSTOMER)
  status       Status    @default(ACTIVE)
  refreshToken String?   // hashed refresh token
  vendor       Vendor?   @relation(fields: [vendorId], references: [id])
  vendorId     String?
  bookings     Booking[]
  reviews      Review[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
}

// ------------------------------------------------------------ taxonomy

model Department {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?    // icon URL
  banner      String?    // banner image URL
  seoTitle    String?
  seoDesc     String?
  sortOrder   Int        @default(0)
  status      Status     @default(ACTIVE)
  categories  Category[]
  vendors     Vendor[]
  items       Item[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, sortOrder])
}

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String
  description  String?
  image        String?
  sortOrder    Int        @default(0)
  status       Status     @default(ACTIVE)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  items        Item[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([departmentId, slug])
  @@index([departmentId, status, sortOrder])
}

model Item {
  id               String     @id @default(cuid())
  name             String
  description      String?
  images           String[]   @default([])
  // dynamic pricing
  minPrice         Decimal    @default(0) @db.Decimal(12, 2)
  maxPrice         Decimal    @default(0) @db.Decimal(12, 2)
  offerPrice       Decimal?   @db.Decimal(12, 2)
  discountPercent  Decimal    @default(0) @db.Decimal(5, 2)
  seasonalPrice    Decimal?   @db.Decimal(12, 2)
  weekendPrice     Decimal?   @db.Decimal(12, 2)
  festivalPrice    Decimal?   @db.Decimal(12, 2)
  taxPercent       Decimal    @default(0) @db.Decimal(5, 2)
  additionalCharge Decimal    @default(0) @db.Decimal(12, 2)
  currency         String     @default("INR")
  priceUnit        PriceUnit  @default(PER_ITEM)
  available        Boolean    @default(true)
  status           Status     @default(ACTIVE)
  department       Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId     String
  category         Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId       String
  vendor           Vendor?    @relation(fields: [vendorId], references: [id])
  vendorId         String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([departmentId, categoryId, status])
}

// ------------------------------------------------------------- vendors

model Vendor {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  logo           String?
  coverImage     String?
  gallery        String[]  @default([])
  description    String?
  experience     Int       @default(0) // years
  location       String?
  latitude       Float?    // for "near me" proximity search
  longitude      Float?
  availableCities String[] @default([])
  rating         Float     @default(0)
  reviewCount    Int       @default(0)
  contactNumber  String?
  whatsapp       String?
  email          String?
  website        String?
  instagram      String?
  facebook       String?
  priceFrom      Decimal   @default(0) @db.Decimal(12, 2)
  priceTo        Decimal   @default(0) @db.Decimal(12, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  available      Boolean   @default(true)
  featured       Boolean   @default(false)
  trending       Boolean   @default(false)
  verified       Boolean   @default(false)
  status         Status    @default(ACTIVE)
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId   String
  packages       Package[]
  items          Item[]
  reviews        Review[]
  bookings       Booking[]
  users          User[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([departmentId, status, featured, trending])
}

model Package {
  id          String   @id @default(cuid())
  name        String   // Basic / Premium / Luxury
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("INR")
  features    String[] @default([]) // list of inclusions
  sortOrder   Int      @default(0)
  popular     Boolean  @default(false)
  status      Status   @default(ACTIVE)
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId    String
  bookings    Booking[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vendorId, status, sortOrder])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      @default(5)
  comment   String?
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId  String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  authorName String?
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())

  @@index([vendorId, status])
}

// ------------------------------------------------------------ bookings

model Booking {
  id                  String        @id @default(cuid())
  reference           String        @unique @default(cuid())
  customer            User?         @relation(fields: [customerId], references: [id])
  customerId          String?
  customerName        String
  customerEmail       String
  customerPhone       String?
  vendor              Vendor?       @relation(fields: [vendorId], references: [id])
  vendorId            String?
  package             Package?      @relation(fields: [packageId], references: [id])
  packageId           String?
  eventDate           DateTime?
  location            String?
  guestCount          Int?
  budget              Decimal?      @db.Decimal(12, 2)
  specialRequirements String?
  items               Json?         // [{itemId, name, quantity, price}]
  status              BookingStatus @default(PENDING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([status, createdAt])
}

// ------------------------------------------------------------------ cms

model CmsBlock {
  id        String       @id @default(cuid())
  key       String       @unique // e.g. home-hero, home-slider-1, footer-about
  type      CmsBlockType @default(SECTION)
  title     String?
  subtitle  String?
  content   String?
  image     String?
  link      String?
  data      Json?        // arbitrary structured content (slides, columns, etc.)
  sortOrder Int          @default(0)
  status    Status       @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([type, status, sortOrder])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  avatar    String?
  rating    Int      @default(5)
  message   String
  approved  Boolean  @default(false) // public submissions start unapproved; admin approves
  sortOrder Int      @default(0)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approved, status, sortOrder])
  @@index([status, sortOrder])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  sortOrder Int      @default(0)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
}

// ------------------------------------------------------------- media

model MediaAsset {
  id        String        @id @default(cuid())
  url       String
  publicId  String? // Cloudinary public id (for deletion)
  provider  MediaProvider @default(LOCAL)
  filename  String
  mimeType  String?
  size      Int?
  folder    String?
  createdAt DateTime      @default(now())

  @@index([folder, createdAt])
}
