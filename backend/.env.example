DATABASE_URL=postgresql://elite:elite_secret@localhost:5432/elite_events?schema=public
# Generate strong random values — the app refuses to start with blank/placeholder
# secrets: `openssl rand -base64 48`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
PORT=4000
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
# Shared with the frontend's PROXY_SHARED_SECRET (same value on both). Lets the
# frontend proxy tell the API each visitor's real IP, so rate limits (login,
# bookings, testimonials) apply per visitor instead of to the whole site.
# Without it every visitor shares one bucket. `openssl rand -base64 48`
PROXY_SHARED_SECRET=

# ---- Seeding (optional) ----
# Admin login created by `npm run seed`. If SEED_ADMIN_PASSWORD is unset, a strong
# random password is generated and printed once during seeding.
SEED_ADMIN_EMAIL=admin@elite.events
SEED_ADMIN_PASSWORD=

# ---- File uploads ----
# Leave Cloudinary vars blank to store files locally in backend/uploads (served at /uploads).
# Set them to switch to Cloudinary automatically.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or a single connection string: CLOUDINARY_URL=cloudinary://key:secret@cloud_name
